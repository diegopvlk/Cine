From 391881e24f424ec1bf25e52c3dd700ec9748d15f Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Kacper=20Michaj=C5=82ow?= <kasper93@gmail.com>
Date: Thu, 12 Nov 2026 01:41:28 +0100
Subject: [PATCH 2/7] vo_gpu_next/context: split the swapchain creation from
 the GPU creation

create_gpu() creates the libplacebo GPU for the API of the ra_ctx and
create_swapchain() the swapchain for its window.
---
 video/out/gpu_next/context.c | 172 ++++++++++++++++++-----------------
 1 file changed, 89 insertions(+), 83 deletions(-)

diff --git a/video/out/gpu_next/context.c b/video/out/gpu_next/context.c
index 04eaec7dee81e..0ead48fafeb41 100644
--- a/video/out/gpu_next/context.c
+++ b/video/out/gpu_next/context.c
@@ -50,91 +50,42 @@
 #include "video/out/vulkan/context.h"
 #endif
 
-#if HAVE_D3D11
-static bool d3d11_pl_init(struct vo *vo, struct gpu_ctx *ctx)
-{
-#if !defined(PL_HAVE_D3D11)
-    MP_MSG(ctx, vo->probing ? MSGL_V : MSGL_ERR,
-           "libplacebo was built without D3D11 support.\n");
-    return false;
-#else // defined(PL_HAVE_D3D11)
-    bool success = false;
-
-    ID3D11Device   *device    = ra_d3d11_get_device(ctx->ra_ctx->ra);
-    IDXGISwapChain *swapchain = ra_d3d11_ctx_get_swapchain(ctx->ra_ctx);
-    if (!device || !swapchain) {
-        mp_err(ctx->log,
-               "Failed to receive required components from the mpv d3d11 "
-               "context! (device: %s, swap chain: %s)\n",
-               device    ? "OK" : "failed",
-               swapchain ? "OK" : "failed");
-        goto err_out;
-    }
-
-    pl_d3d11 d3d11 = pl_d3d11_create(ctx->pllog,
-        pl_d3d11_params(
-            .device = device,
-        )
-    );
-    if (!d3d11) {
-        mp_err(ctx->log, "Failed to acquire a d3d11 libplacebo context!\n");
-        goto err_out;
-    }
-    ctx->gpu = d3d11->gpu;
-
-    mppl_log_set_probing(ctx->pllog, false);
-
-    struct pl_d3d11_swapchain_params *params = pl_d3d11_swapchain_params(
-         .swapchain = swapchain,
-    );
-    ra_d3d11_ctx_set_swapchain_params(ctx->ra_ctx, params);
-    ctx->swapchain = pl_d3d11_create_swapchain(d3d11, params);
-    if (!ctx->swapchain) {
-        mp_err(ctx->log, "Failed to acquire a d3d11 libplacebo swap chain!\n");
-        goto err_out;
-    }
-
-    success = true;
-
-err_out:
-    SAFE_RELEASE(swapchain);
-    SAFE_RELEASE(device);
-
-    return success;
-#endif // defined(PL_HAVE_D3D11)
-}
-#endif // HAVE_D3D11
-
-struct gpu_ctx *gpu_ctx_create(struct vo *vo, struct ra_ctx_opts *ctx_opts)
+static bool create_gpu(struct gpu_ctx *ctx, bool probing)
 {
-    struct gpu_ctx *ctx = talloc_zero(NULL, struct gpu_ctx);
-    ctx->log = vo->log;
-    ctx->ra_ctx = ra_ctx_create(vo, *ctx_opts);
-    if (!ctx->ra_ctx)
-        goto err_out;
-
 #if HAVE_VULKAN
     struct mpvk_ctx *vkctx = ra_vk_ctx_get(ctx->ra_ctx);
     if (vkctx) {
         ctx->pllog = vkctx->pllog;
         ctx->gpu = vkctx->gpu;
-        ctx->swapchain = vkctx->swapchain;
-        return ctx;
+        return true;
     }
 #endif
 
     ctx->pllog = mppl_log_create(ctx, ctx->log);
     if (!ctx->pllog)
-        goto err_out;
+        return false;
 
-    mppl_log_set_probing(ctx->pllog, vo->probing);
+    mppl_log_set_probing(ctx->pllog, probing);
 
-#if HAVE_D3D11
+#if HAVE_D3D11 && defined(PL_HAVE_D3D11)
     if (ra_is_d3d11(ctx->ra_ctx->ra)) {
-        if (!d3d11_pl_init(vo, ctx))
-            goto err_out;
-
-        return ctx;
+        ID3D11Device *device = ra_d3d11_get_device(ctx->ra_ctx->ra);
+        pl_d3d11 d3d11 = pl_d3d11_create(ctx->pllog,
+            pl_d3d11_params(
+                .device = device,
+            )
+        );
+        SAFE_RELEASE(device);
+        if (!d3d11) {
+            mp_err(ctx->log, "Failed to acquire a d3d11 libplacebo context!\n");
+            return false;
+        }
+        ctx->gpu = d3d11->gpu;
+    }
+#elif HAVE_D3D11
+    if (ra_is_d3d11(ctx->ra_ctx->ra)) {
+        MP_MSG(ctx, probing ? MSGL_V : MSGL_ERR,
+               "libplacebo was built without D3D11 support.\n");
     }
 #endif
 
@@ -153,27 +104,82 @@ struct gpu_ctx *gpu_ctx_create(struct vo *vo, struct ra_ctx_opts *ctx_opts)
 # endif
         pl_opengl opengl = pl_opengl_create(ctx->pllog, &params);
         if (!opengl)
-            goto err_out;
+            return false;
         ctx->gpu = opengl->gpu;
+    }
+#elif HAVE_GL
+    if (ra_is_gl(ctx->ra_ctx->ra)) {
+        MP_MSG(ctx, probing ? MSGL_V : MSGL_ERR,
+            "libplacebo was built without OpenGL support.\n");
+    }
+#endif
 
-        mppl_log_set_probing(ctx->pllog, false);
+    if (!ctx->gpu)
+        return false;
 
-        ctx->swapchain = pl_opengl_create_swapchain(opengl, pl_opengl_swapchain_params(
-            .max_swapchain_depth = vo->opts->swapchain_depth,
-            .framebuffer.flipped = gl->flipped,
-        ));
-        if (!ctx->swapchain)
-            goto err_out;
+    mppl_log_set_probing(ctx->pllog, false);
+    return true;
+}
 
-        return ctx;
+static bool create_swapchain(struct gpu_ctx *ctx, int swapchain_depth)
+{
+#if HAVE_VULKAN
+    struct mpvk_ctx *vkctx = ra_vk_ctx_get(ctx->ra_ctx);
+    if (vkctx) {
+        ctx->swapchain = vkctx->swapchain;
+        return true;
     }
-#elif HAVE_GL
+#endif
+
+#if HAVE_D3D11 && defined(PL_HAVE_D3D11)
+    if (ra_is_d3d11(ctx->ra_ctx->ra)) {
+        IDXGISwapChain *swapchain = ra_d3d11_ctx_get_swapchain(ctx->ra_ctx);
+        if (!swapchain) {
+            mp_err(ctx->log, "Failed to receive the swap chain from the mpv d3d11 context!\n");
+            return false;
+        }
+
+        struct pl_d3d11_swapchain_params *params = pl_d3d11_swapchain_params(
+             .swapchain = swapchain,
+        );
+        ra_d3d11_ctx_set_swapchain_params(ctx->ra_ctx, params);
+        ctx->swapchain = pl_d3d11_create_swapchain(pl_d3d11_get(ctx->gpu), params);
+        SAFE_RELEASE(swapchain);
+        if (!ctx->swapchain)
+            mp_err(ctx->log, "Failed to acquire a d3d11 libplacebo swap chain!\n");
+    }
+#endif
+
+#if HAVE_GL && defined(PL_HAVE_OPENGL)
     if (ra_is_gl(ctx->ra_ctx->ra)) {
-        MP_MSG(ctx, vo->probing ? MSGL_V : MSGL_ERR,
-            "libplacebo was built without OpenGL support.\n");
+        struct GL *gl = ra_gl_get(ctx->ra_ctx->ra);
+        pl_opengl opengl = pl_opengl_get(ctx->gpu);
+        ctx->swapchain = pl_opengl_create_swapchain(opengl, pl_opengl_swapchain_params(
+            .max_swapchain_depth = swapchain_depth,
+            .framebuffer.flipped = gl->flipped,
+        ));
     }
 #endif
 
+    return ctx->swapchain;
+}
+
+struct gpu_ctx *gpu_ctx_create(struct vo *vo, struct ra_ctx_opts *ctx_opts)
+{
+    struct gpu_ctx *ctx = talloc_zero(NULL, struct gpu_ctx);
+    ctx->log = vo->log;
+    ctx->ra_ctx = ra_ctx_create(vo, *ctx_opts);
+    if (!ctx->ra_ctx)
+        goto err_out;
+
+    if (!create_gpu(ctx, vo->probing))
+        goto err_out;
+
+    if (!create_swapchain(ctx, vo->opts->swapchain_depth))
+        goto err_out;
+
+    return ctx;
+
 err_out:
     gpu_ctx_destroy(&ctx);
     return NULL;

From dbf2729b32ceccca47c403666bde74cb4355b0b2 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Kacper=20Michaj=C5=82ow?= <kasper93@gmail.com>
