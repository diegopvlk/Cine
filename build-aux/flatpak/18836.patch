From 5b29049986d02db14772d3f59fc17056d766eb7e Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Kacper=20Michaj=C5=82ow?= <kasper93@gmail.com>
Date: Thu, 12 Nov 2026 01:44:33 +0100
Subject: [PATCH 6/7] ra_gl: add a getter for the framebuffer object of a
 texture

ra_gl_get_raw_tex() returns no texture for a ra_tex that wraps a
framebuffer.
---
 video/out/opengl/ra_gl.c | 6 ++++++
 video/out/opengl/ra_gl.h | 1 +
 2 files changed, 7 insertions(+)

diff --git a/video/out/opengl/ra_gl.c b/video/out/opengl/ra_gl.c
index abeff2381f525..ca49ec7a36ff1 100644
--- a/video/out/opengl/ra_gl.c
+++ b/video/out/opengl/ra_gl.c
@@ -482,6 +482,12 @@ void ra_gl_get_raw_tex(struct ra *ra, struct ra_tex *tex,
     *out_target = tex_gl->target;
 }
 
+GLuint ra_gl_get_raw_fbo(struct ra *ra, struct ra_tex *tex)
+{
+    struct ra_tex_gl *tex_gl = tex->priv;
+    return tex_gl->fbo;
+}
+
 // Return whether the ra instance was created with ra_create_gl(). This is the
 // _only_ function that can be called on a ra instance of any type.
 bool ra_is_gl(struct ra *ra)
diff --git a/video/out/opengl/ra_gl.h b/video/out/opengl/ra_gl.h
index 9844977801e23..13ff91fd1409e 100644
--- a/video/out/opengl/ra_gl.h
+++ b/video/out/opengl/ra_gl.h
@@ -14,4 +14,5 @@ void ra_gl_get_format(const struct ra_format *fmt, GLint *out_internal_format,
                       GLenum *out_format, GLenum *out_type);
 void ra_gl_get_raw_tex(struct ra *ra, struct ra_tex *tex,
                        GLuint *out_texture, GLenum *out_target);
+GLuint ra_gl_get_raw_fbo(struct ra *ra, struct ra_tex *tex);
 bool ra_is_gl(struct ra *ra);

From 10fec43f15833e726f201dabea37cafa10946f93 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Kacper=20Michaj=C5=82ow?= <kasper93@gmail.com>
Date: Thu, 12 Nov 2026 01:45:30 +0100
Subject: [PATCH 7/7] vo_gpu_next/context: wrap the framebuffer of a ra_gl
 texture

A ra_tex that wraps a framebuffer has no texture, and libplacebo took
it for the default framebuffer. The textures of the hwdecs have no
framebuffer object, nothing changes for them.
---
 video/out/gpu_next/context.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/video/out/gpu_next/context.c b/video/out/gpu_next/context.c
index 1120227dfd4af..1232b48859468 100644
--- a/video/out/gpu_next/context.c
+++ b/video/out/gpu_next/context.c
@@ -192,6 +192,7 @@ pl_tex gpu_ctx_wrap_ra_tex(pl_gpu gpu, struct ra *ra, struct ra_tex *ratex)
         ra_gl_get_format(ratex->params.format, &par.iformat,
                          &(GLenum){0}, &(GLenum){0});
         ra_gl_get_raw_tex(ra, ratex, &par.texture, &par.target);
+        par.framebuffer = ra_gl_get_raw_fbo(ra, ratex);
         return pl_opengl_wrap(gpu, &par);
     }
 #endif
