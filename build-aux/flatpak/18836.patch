From 475a96b38f20da315214d7d38e91bf2b411f8508 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Kacper=20Michaj=C5=82ow?= <kasper93@gmail.com>
Date: Thu, 12 Nov 2026 01:44:16 +0100
Subject: [PATCH 5/7] vo_gpu_next: move the ra_tex wrapping to the context

---
 video/out/gpu_next/context.c | 48 +++++++++++++++++++++++++
 video/out/gpu_next/context.h |  4 +++
 video/out/gpu_next/video.c   | 68 ++++--------------------------------
 3 files changed, 58 insertions(+), 62 deletions(-)

diff --git a/video/out/gpu_next/context.c b/video/out/gpu_next/context.c
index 116256d68e4b2..1120227dfd4af 100644
--- a/video/out/gpu_next/context.c
+++ b/video/out/gpu_next/context.c
@@ -29,6 +29,7 @@
 #include "config.h"
 #include "common/common.h"
 #include "options/m_config.h"
+#include "video/out/placebo/ra_pl.h"
 #include "video/out/placebo/utils.h"
 #include "video/out/gpu/video.h"
 
@@ -176,6 +177,53 @@ struct gpu_ctx *gpu_ctx_create(struct mp_log *log, struct ra_ctx *ra_ctx, bool p
     return ctx;
 }
 
+pl_tex gpu_ctx_wrap_ra_tex(pl_gpu gpu, struct ra *ra, struct ra_tex *ratex)
+{
+    if (ra_pl_get(ra))
+        return (pl_tex) ratex->priv;
+
+#if HAVE_GL && defined(PL_HAVE_OPENGL)
+    if (ra_is_gl(ra) && pl_opengl_get(gpu)) {
+        struct pl_opengl_wrap_params par = {
+            .width = ratex->params.w,
+            .height = ratex->params.h,
+        };
+
+        ra_gl_get_format(ratex->params.format, &par.iformat,
+                         &(GLenum){0}, &(GLenum){0});
+        ra_gl_get_raw_tex(ra, ratex, &par.texture, &par.target);
+        return pl_opengl_wrap(gpu, &par);
+    }
+#endif
+
+#if HAVE_D3D11 && defined(PL_HAVE_D3D11)
+    if (ra_is_d3d11(ra)) {
+        int array_slice = 0;
+        ID3D11Resource *res = ra_d3d11_get_raw_tex(ra, ratex, &array_slice);
+        pl_tex tex = pl_d3d11_wrap(gpu, pl_d3d11_wrap_params(
+            .tex = res,
+            .array_slice = array_slice,
+            .fmt = ra_d3d11_get_format(ratex->params.format),
+            .w = ratex->params.w,
+            .h = ratex->params.h,
+        ));
+        SAFE_RELEASE(res);
+        return tex;
+    }
+#endif
+
+    return NULL;
+}
+
+void gpu_ctx_unwrap_ra_tex(pl_gpu gpu, struct ra *ra, pl_tex *tex)
+{
+    if (ra_pl_get(ra)) {
+        *tex = NULL;
+    } else {
+        pl_tex_destroy(gpu, tex);
+    }
+}
+
 bool gpu_ctx_resize(struct gpu_ctx *ctx, int w, int h)
 {
 #if HAVE_VULKAN
diff --git a/video/out/gpu_next/context.h b/video/out/gpu_next/context.h
index f388c058cff29..cdc788b369a9a 100644
--- a/video/out/gpu_next/context.h
+++ b/video/out/gpu_next/context.h
@@ -20,7 +20,9 @@
 #include <libplacebo/renderer.h>
 
 struct mp_log;
+struct ra;
 struct ra_ctx;
+struct ra_tex;
 
 struct gpu_ctx {
     struct mp_log *log;
@@ -37,4 +39,6 @@ struct gpu_ctx {
 struct gpu_ctx *gpu_ctx_create(struct mp_log *log, struct ra_ctx *ra_ctx, bool probing);
 bool gpu_ctx_create_swapchain(struct gpu_ctx *ctx, int swapchain_depth);
 bool gpu_ctx_resize(struct gpu_ctx *ctx, int w, int h);
+pl_tex gpu_ctx_wrap_ra_tex(pl_gpu gpu, struct ra *ra, struct ra_tex *ratex);
+void gpu_ctx_unwrap_ra_tex(pl_gpu gpu, struct ra *ra, pl_tex *tex);
 void gpu_ctx_destroy(struct gpu_ctx **ctxp);
diff --git a/video/out/gpu_next/video.c b/video/out/gpu_next/video.c
index 418575ea87ca6..99960e71b354d 100644
--- a/video/out/gpu_next/video.c
+++ b/video/out/gpu_next/video.c
@@ -43,7 +43,6 @@
 #include "sub/draw_bmp.h"
 #include "video/fmt-conversion.h"
 #include "video/mp_image.h"
-#include "video/out/placebo/ra_pl.h"
 #include "video/out/placebo/utils.h"
 #include "video/out/gpu/context.h"
