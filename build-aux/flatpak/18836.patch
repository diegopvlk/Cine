+struct gpu_ctx *gpu_ctx_create(struct vo *vo, struct ra_ctx *ra_ctx)
 {
     struct gpu_ctx *ctx = talloc_zero(NULL, struct gpu_ctx);
     ctx->log = vo->log;
-    ctx->ra_ctx = ra_ctx_create(vo, *ctx_opts);
-    if (!ctx->ra_ctx)
