+++ b/video/out/gpu/libmpv_gpu.h
@@ -37,5 +37,12 @@ struct libmpv_gpu_context_fns {
     void (*destroy)(struct libmpv_gpu_context *ctx);
 };
 
+// Create the context for the MPV_RENDER_PARAM_API_TYPE API.
+// Returns a libmpv error code.
