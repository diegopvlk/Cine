From f97d250f34611f3ba06f7ccffeada72e530a2f63 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Kacper=20Michaj=C5=82ow?= <kasper93@gmail.com>
Date: Thu, 12 Nov 2026 08:47:10 +0100
Subject: [PATCH 1/3] vo: use get_image when get_image_ts returns no image

A driver could set only one of the two callbacks. A driver whose GPU
is thread safe with some APIs and not with others can only tell at
run time which one applies. Let it set both. The thread safe callback
is asked first, and the one on the VO thread if it returns nothing.
---
 video/out/vo.c | 9 +++++----
 video/out/vo.h | 8 +++++---
 2 files changed, 10 insertions(+), 7 deletions(-)

diff --git a/video/out/vo.c b/video/out/vo.c
index c54c19dfd0e46..a61f21a2a8693 100644
--- a/video/out/vo.c
+++ b/video/out/vo.c
@@ -1829,11 +1829,12 @@ struct vo_frame *vo_get_current_vo_frame(struct vo *vo)
 struct mp_image *vo_get_image(struct vo *vo, int imgfmt, int w, int h,
                               int stride_align, int flags)
 {
+    struct mp_image *img = NULL;
     if (vo->driver->get_image_ts)
-        return vo->driver->get_image_ts(vo, imgfmt, w, h, stride_align, flags);
-    if (vo->in->dr_helper)
-        return dr_helper_get_image(vo->in->dr_helper, imgfmt, w, h, stride_align, flags);
-    return NULL;
+        img = vo->driver->get_image_ts(vo, imgfmt, w, h, stride_align, flags);
+    if (!img && vo->in->dr_helper)
+        img = dr_helper_get_image(vo->in->dr_helper, imgfmt, w, h, stride_align, flags);
+    return img;
 }
 
 static void destroy_frame(void *p)
diff --git a/video/out/vo.h b/video/out/vo.h
index 92f55bf8599ea..5098ec75b5f29 100644
--- a/video/out/vo.h
+++ b/video/out/vo.h
@@ -399,9 +399,11 @@ struct vo_driver {
                                   int stride_align, int flags);
 
     /*
-     * Thread-safe variant of get_image. Set at most one of these callbacks.
-     * This excludes _all_ synchronization magic. The only guarantee is that
-     * vo_driver.uninit is not called before this function returns.
+     * Thread-safe variant of get_image. This excludes _all_ synchronization
+     * magic. The only guarantee is that vo_driver.uninit is not called before
+     * this function returns.
+     *
+     * If both callbacks are set, get_image is used when this one returns NULL.
      */
     struct mp_image *(*get_image_ts)(struct vo *vo, int imgfmt, int w, int h,
                                      int stride_align, int flags);

From e52e65a27803576e6ff8ec4253372c89400d9b01 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Kacper=20Michaj=C5=82ow?= <kasper93@gmail.com>
Date: Thu, 12 Nov 2026 08:49:14 +0100
Subject: [PATCH 2/3] vo_gpu_next: leave the thread safety of get_image to the
 caller

mppl_video_get_image() refused to allocate when the GPU is not thread
safe. Whether that matters depends on the caller. The VO is called
from the decoder threads and keeps the check. The render API calls on
the thread it renders on, and gets direct rendering with OpenGL now,
as it has with the gpu renderer.
---
 video/out/gpu_next/video.c |  2 +-
 video/out/vo_gpu_next.c    | 11 ++++++++++-
 2 files changed, 11 insertions(+), 2 deletions(-)

diff --git a/video/out/gpu_next/video.c b/video/out/gpu_next/video.c
index 99960e71b354d..3cefbde9d9226 100644
--- a/video/out/gpu_next/video.c
+++ b/video/out/gpu_next/video.c
@@ -296,7 +296,7 @@ struct mp_image *mppl_video_get_image(struct mppl_video *p, int imgfmt, int w, i
                                       int stride_align, int flags)
 {
     pl_gpu gpu = p->gpu;
-    if (!gpu->limits.thread_safe || !gpu->limits.max_mapped_size)
+    if (!gpu->limits.max_mapped_size)
         return NULL;
 
     if ((flags & VO_DR_FLAG_HOST_CACHED) && !gpu->limits.host_cached)
diff --git a/video/out/vo_gpu_next.c b/video/out/vo_gpu_next.c
index 8c94299f793d1..e028302652100 100644
--- a/video/out/vo_gpu_next.c
+++ b/video/out/vo_gpu_next.c
@@ -154,6 +154,15 @@ static struct mp_image *get_image(struct vo *vo, int imgfmt, int w, int h,
     return mppl_video_get_image(p->renderer, imgfmt, w, h, stride_align, flags);
 }
 
+static struct mp_image *get_image_ts(struct vo *vo, int imgfmt, int w, int h,
+                                     int stride_align, int flags)
+{
+    struct priv *p = vo->priv;
+    if (!p->context->gpu->limits.thread_safe)
+        return NULL;
+    return get_image(vo, imgfmt, w, h, stride_align, flags);
+}
+
 static void resize(struct vo *vo)
 {
     struct priv *p = vo->priv;
@@ -352,7 +361,7 @@ const struct vo_driver video_out_gpu_next = {
     .query_format = query_format,
     .reconfig = reconfig,
     .control = control,
-    .get_image_ts = get_image,
+    .get_image_ts = get_image_ts,
     .draw_frame = draw_frame,
     .flip_page = flip_page,
     .get_vsync = get_vsync,

From 463799d27221cc968e5b05f35078ca622bb95e66 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Kacper=20Michaj=C5=82ow?= <kasper93@gmail.com>
Date: Thu, 12 Nov 2026 08:51:42 +0100
Subject: [PATCH 3/3] vo_gpu_next: support direct rendering with OpenGL

Direct rendering needed a thread safe GPU, which only Vulkan is.
libplacebo maps buffers with OpenGL 4.4 as well, but has to be called
on the thread of the context. Set get_image too, so that vo.c runs
the allocation and the release on the VO thread.
---
 DOCS/man/options.rst    | 2 +-
 video/out/vo_gpu_next.c | 1 +
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/DOCS/man/options.rst b/DOCS/man/options.rst
index e9d93b6897e97..846dec1518e9b 100644
--- a/DOCS/man/options.rst
+++ b/DOCS/man/options.rst
@@ -1960,7 +1960,7 @@ Video
     This can speed up video upload, and may help with large resolutions or
     slow hardware. This works only with the following VOs:
 
-        - ``gpu``: requires at least OpenGL 4.4 or Vulkan.
+        - ``gpu-next``, ``gpu``: requires at least OpenGL 4.4 or Vulkan.
         - ``libmpv``: The libmpv render API has optional support.
 
     The ``auto`` option will try to guess whether DR can improve performance
diff --git a/video/out/vo_gpu_next.c b/video/out/vo_gpu_next.c
index e028302652100..adff8aac74da1 100644
--- a/video/out/vo_gpu_next.c
+++ b/video/out/vo_gpu_next.c
@@ -361,6 +361,7 @@ const struct vo_driver video_out_gpu_next = {
     .query_format = query_format,
     .reconfig = reconfig,
     .control = control,
+    .get_image = get_image,
     .get_image_ts = get_image_ts,
     .draw_frame = draw_frame,
     .flip_page = flip_page,
